{
  "name": "restfullbooker-api-testing",
  "version": "1.0.0",
  "description": "API test automation project built using **Postman** and **Newman** to validate the functionality, reliability, and behavior of the Restful Booker API.",
  "main": "index.js",
  "scripts": {
    "start": "node server.js",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:api && npm run test:e2e && npm run security:audit",
    "test:unit": "jest",
    "test:api": "newman run postman/Restful-Booker-API_Testing.postman_collection.json -e postman/Restful-Booker-Testing.postman_environment.json",
    "test:e2e": "playwright test",
    "security:audit": "npm audit --audit-level=critical"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Area-Turtle/restfullbooker-API-testing.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Area-Turtle/restfullbooker-API-testing/issues"
  },
  "homepage": "https://github.com/Area-Turtle/restfullbooker-API-testing#readme",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "newman": "^6.2.2",
    "wait-on": "^9.0.0"
  },
  "overrides":{
    "handlebars": "4.7.9"
  }
}
